struct Vector3 { x: f64, y: f64, z: f64 }

enum Shape { Circle(f64), Rectangle(f64, f64), Triangle(f64, f64, f64) }

fn fib(n: i64) -> i64 {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn gcd(a: i64, b: i64) -> i64 {
    while b != 0 {
        let t = b;
        b = a % b;
        a = t;
    }
    return a;
}

fn factorial(n: i64) -> i64 {
    let r = 1;
    let i = 1;
    while i <= n {
        let tmp = r * i;
        r = tmp;
        let inc = i + 1;
        i = inc;
    }
    return r;
}

fn distance(a: Vector3, b: Vector3) -> f64 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    let dz = a.z - b.z;
    return dx * dx + dy * dy + dz * dz;
}

fn area(shape: Shape) -> f64 {
    match shape {
        Shape::Circle(r) => { 3.14159 * r * r }
        Shape::Rectangle(w, h) => { w * h }
        Shape::Triangle(a, b, c) => {
            let s = (a + b + c) / 2.0;
            s * (s - a) * (s - b) * (s - c)
        }
    }
}

fn collect_sum(xs: list) -> i64 {
    let s = 0;
    for i in 0..len(xs) {
        let val = xs[i];
        let new_s = s + val;
        s = new_s;
    }
    return s;
}

fib(10)
gcd(48, 18)
factorial(10)
