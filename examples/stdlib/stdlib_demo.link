// stdlib_demo.link - 标准库功能演示

fn main() {
    println("=== Standard Library Demo ===");
    
    // 数学函数
    println("--- Math ---");
    println("abs(-42) = {}", abs(-42));
    println("abs(-3.14) = {}", abs(-3.14));
    println("min(3, 7) = {}", min(3, 7));
    println("max(3, 7) = {}", max(3, 7));
    println("sqrt(144) = {}", sqrt(144));
    println("pow(2, 10) = {}", pow(2, 10));
    println("floor(3.7) = {}", floor(3.7));
    println("ceil(3.2) = {}", ceil(3.2));
    println("round(3.5) = {}", round(3.5));
    
    // 字符串函数
    println("--- String ---");
    println("str_len(\"hello\") = {}", str_len("hello"));
    println("str_upper(\"hello\") = {}", str_upper("hello"));
    println("str_lower(\"WORLD\") = {}", str_lower("WORLD"));
    println("str_contains(\"hello world\", \"world\") = {}", str_contains("hello world", "world"));
    println("str_starts_with(\"hello\", \"he\") = {}", str_starts_with("hello", "he"));
    println("str_ends_with(\"hello\", \"lo\") = {}", str_ends_with("hello", "lo"));
    println("str_trim(\"  hi  \") = {}", str_trim("  hi  "));
    println("str_concat(\"foo\", \"bar\") = {}", str_concat("foo", "bar"));
    
    // 类型转换
    println("--- Conversions ---");
    println("int(3.14) = {}", int(3.14));
    println("float(42) = {}", float(42));
    println("int(\"123\") = {}", int("123"));
    println("str(42) = {}", str(42));
    println("bool(0) = {}", bool(0));
    println("bool(1) = {}", bool(1));
    
    // 列表函数
    println("--- List ---");
    let nums = [3, 1, 4, 1, 5, 9, 2, 6];
    println("list_len = {}", len(nums));
    println("list_get(nums, 2) = {}", list_get(nums, 2));
    println("list_contains(nums, 5) = {}", list_contains(nums, 5));
    let reversed = list_reverse(nums);
    println("reversed[0] = {}", list_get(reversed, 0));
    let sorted = list_sort(nums);
    println("sorted[0] = {}", list_get(sorted, 0));
    println("sorted[7] = {}", list_get(sorted, 7));
    let pushed = list_push(nums, 100);
    println("pushed[8] = {}", list_get(pushed, 8));
    
    // 时间函数
    println("--- Time ---");
    let t1 = time_now();
    println("time_now() = {}", t1);
    
    // 文件 IO
    println("--- File IO ---");
    file_write("test_output.txt", "Hello from Link!");
    println("file_exists = {}", file_exists("test_output.txt"));
    let content = file_read("test_output.txt");
    println("file_read = {}", content);
    file_append("test_output.txt", " Appended text.");
    let content2 = file_read("test_output.txt");
    println("after append = {}", content2);
    
    println("=== Stdlib Demo Complete ===");
}
