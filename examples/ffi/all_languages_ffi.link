// 全球十大语言 FFI 示例
// 演示如何通过 Link 调用各种编程语言的外部函数

// ========== 1. C / C++ FFI ==========
// 通过 extern "C" 或 extern "C++" 调用 C/C++ 动态库
extern "C" module "mylib" {
    fn add(a: i32, b: i32) -> i32;
    fn multiply(a: i64, b: i64) -> i64;
    fn greet(name: *c_char) -> *c_char;
}

// ========== 2. Python FFI ==========
// 通过 CPython C API 调用 Python 模块
extern "python" module "math_utils" {
    fn compute(n: i32) -> i32;
    fn transform(data: list) -> list;
}

// ========== 3. Java FFI ==========
// 通过子进程调用 Java 静态方法
extern "java" module "build/classes::com.example.MathUtils" {
    fn add(a: i64, b: i64) -> i64;
    fn multiply(a: i64, b: i64) -> i64;
}

// ========== 4. HTML / JavaScript FFI ==========
// 通过 HTTP 调用浏览器/Node.js 中的 JavaScript 函数
extern "html" module "http://127.0.0.1:3000" {
    fn add(a: i32, b: i32) -> i32;
    fn render_html(content: str) -> str;
}

// ========== 5. WASM FFI ==========
// 加载 WebAssembly 模块并调用导出函数
extern "wasm" module "path/to/module.wasm" {
    fn add(a: i32, b: i32) -> i32;
    fn square(a: i32) -> i32;
}

// ========== 6. Go FFI (进程桥接) ==========
// 通过子进程调用 Go 脚本
extern "go" module "bridge.go" {
    fn add(a: i64, b: i64) -> i64;
    fn greet(name: str) -> str;
}

// ========== 7. Rust FFI (进程桥接) ==========
// 通过子进程调用 Rust 脚本
extern "rust" module "bridge.rs" {
    fn subtract(a: i64, b: i64) -> i64;
}

// ========== 8. C# / .NET FFI (进程桥接) ==========
// 通过子进程调用 .NET 项目
extern "csharp" module "MyBridgeProject" {
    fn multiply(a: i64, b: i64) -> i64;
}

// ========== 9. PHP FFI (进程桥接) ==========
// 通过子进程调用 PHP 脚本
extern "php" module "bridge.php" {
    fn process(data: str) -> str;
}

// ========== 10. Ruby FFI (进程桥接) ==========
// 通过子进程调用 Ruby 脚本
extern "ruby" module "bridge.rb" {
    fn transform(input: i64) -> i64;
}

// ========== 11. Swift FFI (进程桥接) ==========
extern "swift" module "bridge.swift" {
    fn calculate(a: i64, b: i64) -> i64;
}

// ========== 12. Kotlin FFI (进程桥接) ==========
extern "kotlin" module "bridge.kt" {
    fn compute(x: i64) -> i64;
}

// ========== 使用示例 ==========
fn demo() {
    // C/C++ 调用
    let c_result = add(1, 2);
    
    // Python 调用
    let py_result = compute(10);
    
    // Go 调用
    let go_result = add(3, 4);  // 注:会调用 Go bridge 的 add 函数
    
    // 管道操作
    let result = stream([1, 2, 3, 4, 5])
        | map(fn(x) -> i64 { return x * 2; })
        | filter(fn(x) -> bool { return x > 5; })
        | collect();
}