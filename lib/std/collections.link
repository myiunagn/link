// Link standard library: collection utilities.
//
// Operations on lists (LinkList).

struct ListIter {
    items: LinkList,
    index: i64,
}

// sum of all elements
fn sum_list(xs: LinkList) -> i64 {
    let total: i64 = 0;
    let i: i64 = 0;
    while i < xs.count {
        total = total + xs.items[i];
        i = i + 1;
    }
    return total;
}

// count elements matching a predicate
fn count_if(xs: LinkList, pred: fn(i64) -> bool) -> i64 {
    let n: i64 = 0;
    let i: i64 = 0;
    while i < xs.count {
        if pred(xs.items[i]) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// find first element matching a predicate, or -1
fn find(xs: LinkList, pred: fn(i64) -> bool) -> i64 {
    let i: i64 = 0;
    while i < xs.count {
        if pred(xs.items[i]) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// check if all elements match a predicate
fn all(xs: LinkList, pred: fn(i64) -> bool) -> bool {
    let i: i64 = 0;
    while i < xs.count {
        if !pred(xs.items[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// check if any element matches a predicate
fn any(xs: LinkList, pred: fn(i64) -> bool) -> bool {
    return find(xs, pred) >= 0;
}

// reverse the items in-place (returns the modified list)
fn reverse(xs: LinkList) -> LinkList {
    let left: i64 = 0;
    let right: i64 = xs.count - 1;
    while left < right {
        let tmp: i64 = xs.items[left];
        xs.items[left] = xs.items[right];
        xs.items[right] = tmp;
        left = left + 1;
        right = right - 1;
    }
    return xs;
}

// get the maximum element
fn max_list(xs: LinkList) -> i64 {
    let best: i64 = xs.items[0];
    let i: i64 = 1;
    while i < xs.count {
        if xs.items[i] > best {
            best = xs.items[i];
        }
        i = i + 1;
    }
    return best;
}

// get the minimum element
fn min_list(xs: LinkList) -> i64 {
    let best: i64 = xs.items[0];
    let i: i64 = 1;
    while i < xs.count {
        if xs.items[i] < best {
            best = xs.items[i];
        }
        i = i + 1;
    }
    return best;
}
