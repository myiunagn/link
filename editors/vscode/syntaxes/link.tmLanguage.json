{
  "scopeName": "source.link",
  "fileTypes": ["link"],
  "name": "Link",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#none" },
    { "include": "#builtins" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.link",
          "match": "//.*$"
        },
        {
          "name": "comment.block.link",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.link",
          "match": "\\b(fn|return|let|if|else|while|for|in|loop|break|continue|try|catch|throw|match|case|default|use|extern|export|struct|enum|impl|trait|as|mut|const|static|pub|priv)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.link",
          "match": "\\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|bool|str|string|void|none|any|list|map|stream|flow|device|thing)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.link",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.link",
              "match": "\\\\(n|t|r|\\\\|\"|'|0)"
            }
          ]
        },
        {
          "name": "string.quoted.single.link",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.link",
              "match": "\\\\(n|t|r|\\\\|\"|'|0)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.link",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.link",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.link",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "none": {
      "patterns": [
        {
          "name": "constant.language.none.link",
          "match": "\\b(none|null|nil)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.link",
          "match": "\\b(print|println|len|push|pop|shift|unshift|sort|reverse|map|filter|reduce|range|parse|to_str|to_int|to_float|type_of|assert|panic|sleep|spawn|recv|send)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.link",
          "begin": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "beginCaptures": {
            "1": { "name": "keyword.declaration.function.link" },
            "2": { "name": "entity.name.function.link" }
          },
          "end": "(?<=\\})|(?=;)",
          "patterns": [
            { "include": "#comments" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#booleans" },
            { "include": "#builtins" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        },
        {
          "name": "meta.function.call.link",
          "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.link" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.link",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.link",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.link",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.link",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.range.link",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.pipe.link",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.try.link",
          "match": "try!"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.link",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.link",
          "match": ","
        },
        {
          "name": "punctuation.separator.dot.link",
          "match": "\\.(?!\\.)"
        },
        {
          "name": "punctuation.separator.colon.link",
          "match": ":"
        },
        {
          "name": "punctuation.separator.arrow.link",
          "match": "->"
        },
        {
          "name": "punctuation.bracket.curly.link",
          "match": "[{}]"
        },
        {
          "name": "punctuation.bracket.square.link",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.round.link",
          "match": "[()]"
        }
      ]
    }
  }
}
