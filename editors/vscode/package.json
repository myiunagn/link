{
  "name": "link-language",
  "displayName": "Link Language Support",
  "description": "Syntax highlighting and language support for the Link programming language",
  "version": "0.1.0",
  "publisher": "link-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "link",
        "aliases": ["Link", "link"],
        "extensions": [".link"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "link",
        "scopeName": "source.link",
        "path": "./syntaxes/link.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:link"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
